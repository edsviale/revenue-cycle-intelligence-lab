      <column caption='Anesthesia Minutes (Claim Lines.csv)' datatype='integer' name='[Anesthesia Minutes (Claim_Lines.csv)]' role='measure' type='quantitative' />
      <column caption='Carc' datatype='integer' name='[CARC]' role='measure' type='quantitative' />
      <column caption='COUNTD( IF [Initial Claim Status] = &quot;Denied&quot; THEN [Claim ID] ...' datatype='real' default-format='p0.0%' name='[Calculation_0178534114037766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Initial Claim Status] = &quot;Denied&quot; THEN [Claim ID] END&#10;)&#10;/&#10;COUNTD(&#10;    IF [Initial Claim Status] &lt;&gt; &quot;Pending&quot; THEN [Claim ID] END&#10;)' />
      </column>
      <column caption='SUM( IF [Final Claim Status] = &quot;Denied / Open&quot; THEN [Unique R...' datatype='real' name='[Calculation_0178534132891656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [Final Claim Status] = &quot;Denied / Open&quot;&#10;    THEN [Unique Revenue at Risk]&#10;    END&#10;)' />
      </column>
      <column caption='SUM( IF [Preventable] = &quot;Yes&quot; AND [Unique Revenue at Risk Fla...' datatype='real' name='[Calculation_0178534133174283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [Preventable] = &quot;Yes&quot;&#10;    AND [Unique Revenue at Risk Flag] = &quot;Yes&quot;&#10;    THEN [Recoverable Revenue at Risk]&#10;    END&#10;)' />
      </column>
      <column caption='SUM([Recovered Amount]) / SUM([Recoverable Revenue at Risk])' datatype='real' name='[Calculation_0178534135394317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Recovered Amount])&#10;/&#10;SUM([Recoverable Revenue at Risk])' />
      </column>
      <column caption='Unique Recoverable Revenue at Risk' datatype='real' name='[Calculation_0178534135971855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Unique Revenue at Risk Flag] = &quot;Yes&quot;&#10;THEN [Recoverable Revenue at Risk]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Recovered / Unique Recoverable Revenue' datatype='real' name='[Calculation_0178534140522525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Recovered Amount])/SUM([Calculation_0178534135971855])' />
      </column>
      <column caption='Denial Rate' datatype='real' name='[Calculation_0178534142013470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Initial Claim Status] = &quot;Denied&quot; THEN [Claim ID] END&#10;)&#10;/&#10;COUNTD(&#10;    IF [Initial Claim Status] &lt;&gt; &quot;Pending&quot; THEN [Claim ID] END&#10;)' />
      </column>
