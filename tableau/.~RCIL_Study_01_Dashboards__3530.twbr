            <column caption='Unique Recoverable Revenue at Risk' datatype='real' name='[Calculation_0178534135971855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Unique Revenue at Risk Flag] = &quot;Yes&quot;&#10;THEN [Recoverable Revenue at Risk]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Recovered / Unique Recoverable Revenue' datatype='real' name='[Calculation_0178534140522525]' role='measure' type='quantitative'>
